<?xml version="1.0"?>
<!--
  Started by the DawSiteBackup task (see schedule-backup.ps1). Runs "npm run backup" with no window
  and hands its exit code to the Task Scheduler, so a failed backup shows as failed.
-->
<job id="backup">
  <script language="JScript"><![CDATA[
    var code = 1;
    try {
      var shell = new ActiveXObject("WScript.Shell");
      var fso = new ActiveXObject("Scripting.FileSystemObject");
      shell.CurrentDirectory = fso.GetParentFolderName(fso.GetParentFolderName(WScript.ScriptFullName));
      // 0 = hidden window, true = wait for the end and return the exit code
      code = shell.Run('cmd.exe /d /c "npm.cmd run backup >> backups\\backup.log 2>&1"', 0, true);
    } catch (e) {
      code = 1;
    }
    WScript.Quit(code);
  ]]></script>
</job>
