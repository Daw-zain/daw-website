{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "buildCommand": "node scripts/use-postgres.mjs && npm run build"
  },
  "deploy": {
    "startCommand": "npm run start:prod",
    "healthcheckPath": "/ar",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE"
  }
}