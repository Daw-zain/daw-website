# ───────────── Database ─────────────
# Local development (SQLite file, no install needed):
DATABASE_URL="file:./dev.db"
# Production (PostgreSQL) — run `npm run db:use-postgres` first, then e.g.:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/daw_site?schema=public"

# ───────────── Site ─────────────
# Public URL of the site, no trailing slash (used for canonical URLs, sitemap, emails)
SITE_URL="http://localhost:3000"

# ───────────── Security ─────────────
# Long random string (at least 32 chars). Used to sign admin/user sessions.
AUTH_SECRET="change-me-to-a-long-random-string-of-at-least-32-characters"

# First admin account (created by `npm run db:seed` if it does not exist yet)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-strong-password"

# ───────────── Email (SMTP) ─────────────
# Leave SMTP_HOST empty to disable sending; notifications are still saved in the admin dashboard
# and the email content is printed in the server log.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Daw Zainelabideen <no-reply@example.com>"
# Where new-request notifications are sent (can also be changed in Admin → Settings)
ADMIN_NOTIFY_EMAIL=""

# ───────────── Analytics (optional) ─────────────
# Google Analytics 4 measurement ID, e.g. G-XXXXXXX. Leave empty to disable.
NEXT_PUBLIC_GA_ID=""
