// Al Daleel Raqamee – Training & Consulting – data model
// Database: PostgreSQL on Supabase (local dev and the live site share it — see docs/exam-system).
// Enum-like fields are stored as strings (see src/lib/constants.ts).
// Exam-system tables use database-side defaults (dbgenerated / now()) because rows are also
// created by PostgreSQL functions and triggers (supabase/exams.sql), not only by Prisma.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────── Users & security ─────────────

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         String     @default("LEARNER") // ADMIN | EDITOR | LEARNER
  active       Boolean    @default(true)
  locale       String     @default("ar")
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  favorites    Favorite[]
  auditLogs    AuditLog[]
  // LMS-ready: registrations can be linked to a learner account
  registrations Registration[]
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String // create | update | delete | login | export | backup | status
  entity    String
  entityId  String?
  details   String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ───────────── Training ─────────────

model Program {
  id              String    @id @default(cuid())
  slug            String    @unique
  code            String? // short label e.g. PMP
  category        String    @default("certification") // certification | management | agile | technology | tools
  titleAr         String
  titleEn         String
  summaryAr       String
  summaryEn       String
  descriptionAr   String
  descriptionEn   String
  objectivesAr    String    @default("") // one item per line
  objectivesEn    String    @default("")
  audienceAr      String    @default("")
  audienceEn      String    @default("")
  prerequisitesAr String    @default("")
  prerequisitesEn String    @default("")
  outlineAr       String    @default("")
  outlineEn       String    @default("")
  outcomesAr      String    @default("")
  outcomesEn      String    @default("")
  deliveryAr      String    @default("")
  deliveryEn      String    @default("")
  durationAr      String    @default("") // free text, e.g. "5 أيام"
  durationEn      String    @default("")
  hours           Int?
  image           String?
  status          String    @default("COMING_SOON") // OPEN | COMING_SOON | ON_REQUEST | CLOSED
  featured        Boolean   @default(false)
  published       Boolean   @default(true)
  order           Int       @default(0)
  metaTitleAr     String?
  metaTitleEn     String?
  metaDescAr      String?
  metaDescEn      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  sessions        CourseSession[]
  registrations   Registration[]
  // Exam system (docs/exam-system): folders are created automatically by a database trigger
  examFolders     ExamFolder[]
  instructors     CourseInstructor[]
  enrollments     Enrollment[]
  questionCategories QuestionCategory[]
  questions       Question[]
}

model CourseSession {
  id            String         @id @default(cuid())
  programId     String
  program       Program        @relation(fields: [programId], references: [id], onDelete: Cascade)
  startDate     DateTime
  endDate       DateTime?
  scheduleAr    String         @default("") // e.g. "الأحد – الخميس، 5:00 – 9:00 م"
  scheduleEn    String         @default("")
  mode          String         @default("IN_PERSON") // IN_PERSON | ONLINE | HYBRID
  locationAr    String         @default("")
  locationEn    String         @default("")
  seats         Int? // null = not announced
  status        String         @default("OPEN") // OPEN | FULL | CLOSED
  published     Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  registrations Registration[]

  @@index([startDate])
}

model Registration {
  id           String         @id @default(cuid())
  programId    String
  program      Program        @relation(fields: [programId], references: [id], onDelete: Cascade)
  sessionId    String?
  session      CourseSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId       String?
  user         User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName     String
  email        String
  phone        String
  organization String?
  jobTitle     String?
  city         String?
  notes        String?
  locale       String         @default("ar")
  status       String         @default("NEW") // NEW | CONTACTED | CONFIRMED | WAITLIST | CANCELLED
  adminNotes   String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([createdAt])
}

// ───────────── Consulting & corporate ─────────────

model ConsultingService {
  id             String                @id @default(cuid())
  slug           String                @unique
  icon           String                @default("pmo")
  titleAr        String
  titleEn        String
  summaryAr      String
  summaryEn      String
  descriptionAr  String
  descriptionEn  String
  deliverablesAr String                @default("")
  deliverablesEn String                @default("")
  published      Boolean               @default(true)
  order          Int                   @default(0)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  requests       ConsultationRequest[]
}

model ConsultationRequest {
  id            String             @id @default(cuid())
  serviceId     String?
  service       ConsultingService? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  name          String
  email         String
  phone         String?
  organization  String?
  description   String
  contactMethod String             @default("EMAIL") // EMAIL | PHONE | WHATSAPP | ONLINE_MEETING
  preferredDate String?
  locale        String             @default("ar")
  status        String             @default("NEW") // NEW | CONTACTED | SCHEDULED | DONE | CLOSED
  adminNotes    String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model CorporateRequest {
  id             String   @id @default(cuid())
  organization   String
  sector         String
  traineesCount  Int?
  programs       String
  mode           String   @default("IN_PERSON")
  duration       String?
  contactName    String
  jobTitle       String?
  email          String
  phone          String
  notes          String?
  attachmentPath String?
  attachmentName String?
  locale         String   @default("ar")
  status         String   @default("NEW") // NEW | CONTACTED | PROPOSAL_SENT | WON | LOST
  adminNotes     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ContactMessage {
  id         String   @id @default(cuid())
  name       String
  email      String
  phone      String?
  subject    String
  message    String
  locale     String   @default("ar")
  status     String   @default("NEW") // NEW | REPLIED | CLOSED
  adminNotes String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ───────────── Knowledge Hub ─────────────

model Resource {
  id          String     @id @default(cuid())
  slug        String     @unique
  type        String     @default("ARTICLE") // ARTICLE | TIP | VIDEO | TEMPLATE | QUIZ
  category    String     @default("general") // pmp | pmbok | risk | agile | ai | general
  titleAr     String
  titleEn     String
  excerptAr   String     @default("")
  excerptEn   String     @default("")
  bodyAr      String     @default("") // Markdown
  bodyEn      String     @default("")
  coverImage  String?
  videoUrl    String? // YouTube / Vimeo URL
  fileUrl     String? // downloadable template
  quizJson    String? // see docs/ADMIN-GUIDE.md for the format
  readMinutes Int?
  published   Boolean    @default(true)
  featured    Boolean    @default(false)
  publishedAt DateTime   @default(now())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  favorites   Favorite[]

  @@index([publishedAt])
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, resourceId])
}

// ───────────── Credibility content ─────────────

model Credential {
  id           String   @id @default(cuid())
  kind         String   @default("PROFESSIONAL") // PROFESSIONAL | ACADEMIC
  code         String? // PMP, RMP, ACP …
  titleAr      String
  titleEn      String
  issuerAr     String
  issuerEn     String
  year         Int?
  credentialId String?
  verifyUrl    String?
  image        String?
  descriptionAr String  @default("")
  descriptionEn String  @default("")
  published    Boolean  @default(true)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Testimonial {
  id         String   @id @default(cuid())
  name       String
  roleAr     String   @default("")
  roleEn     String   @default("")
  quoteAr    String
  quoteEn    String
  programRef String?
  photo      String?
  consent    Boolean  @default(false) // the person approved publishing
  published  Boolean  @default(false)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Stat {
  id        String   @id @default(cuid())
  value     Int
  prefix    String   @default("")
  suffix    String   @default("")
  labelAr   String
  labelEn   String
  source    String   @default("") // internal note: where this number comes from
  animate   Boolean  @default(true)
  published Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Faq {
  id         String   @id @default(cuid())
  scope      String   @default("general") // general | corporate | consulting | programs
  questionAr String
  questionEn String
  answerAr   String
  answerEn   String
  published  Boolean  @default(true)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ───────────── Newsletter, media, settings, notifications ─────────────

model Subscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  locale         String    @default("ar")
  token          String    @unique
  confirmedAt    DateTime?
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
}

model Media {
  id        String   @id @default(cuid())
  filename  String
  path      String // storage-relative path
  url       String // public URL (/uploads/…)
  mime      String
  size      Int
  altAr     String   @default("")
  altEn     String   @default("")
  createdAt DateTime @default(now())
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Notification {
  id        String    @id @default(cuid())
  type      String // registration | consultation | corporate | contact | subscriber
  title     String
  body      String
  link      String?
  read      Boolean   @default(false)
  emailedAt DateTime?
  emailError String?
  createdAt DateTime  @default(now())

  @@index([createdAt])
}

// ───────────── Exam system · Phase 1: members, course roles, enrollment, folders ─────────────
// Online identity = Supabase Auth (auth.users). ExamMember maps an auth user to a role.
// Browser roles (anon / authenticated) have NO direct access to these tables: everything goes
// through SECURITY DEFINER functions in supabase/exams.sql that check the caller's session.

model ExamMember {
  id          String             @id @default(dbgenerated("gen_random_uuid()::text"))
  authUserId  String             @unique // auth.users.id
  email       String             @unique
  name        String             @default("")
  role        String             @default("LEARNER") // ADMIN | INSTRUCTOR | LEARNER
  active      Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @default(now()) @updatedAt
  instructing CourseInstructor[]
  enrollments Enrollment[]
}

model CourseInstructor {
  id                    String     @id @default(dbgenerated("gen_random_uuid()::text"))
  programId             String
  program               Program    @relation(fields: [programId], references: [id], onDelete: Cascade)
  memberId              String
  member                ExamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  // Flexible permissions set by the admin (section 17.5)
  canEditQuestions      Boolean    @default(true)
  canDeleteQuestions    Boolean    @default(false)
  canManageCategories   Boolean    @default(true)
  canManageScenarios    Boolean    @default(true)
  canImport             Boolean    @default(true)
  canExport             Boolean    @default(false)
  canCreateExams        Boolean    @default(true)
  canPublishExams       Boolean    @default(false) // false = needs admin approval
  canManageDomainTests  Boolean    @default(true)
  canManageSimulations  Boolean    @default(true)
  canViewResults        Boolean    @default(true)
  canReviewEssays       Boolean    @default(true)
  canReopenAttempts     Boolean    @default(false)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @default(now()) @updatedAt

  @@unique([programId, memberId])
}

model Enrollment {
  id             String     @id @default(dbgenerated("gen_random_uuid()::text"))
  programId      String
  program        Program    @relation(fields: [programId], references: [id], onDelete: Cascade)
  memberId       String
  member         ExamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  status         String     @default("ACTIVE") // ACTIVE | SUSPENDED | COMPLETED
  registrationId String?    // the Registration request it came from, if any
  createdById    String?    // ExamMember.id of the admin/instructor who enrolled
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @default(now()) @updatedAt

  @@unique([programId, memberId])
}

model ExamFolder {
  id          String   @id @default(dbgenerated("gen_random_uuid()::text"))
  programId   String
  program     Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  kind        String // QUESTION_BANK | DOMAIN_TESTS | EXAM_SIMULATIONS | MISTAKES_QUIZ | RESULTS | CUSTOM
  system      Boolean  @default(false) // the 5 built-in folders; one per kind per course (unique index in SQL)
  nameAr      String
  nameEn      String
  descAr      String   @default("")
  descEn      String   @default("")
  status      String   @default("ACTIVE") // ACTIVE | HIDDEN | ARCHIVED
  sortOrder   Int      @default(0)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([programId])
}

model ExamAuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()::text"))
  actorId   String? // ExamMember.id
  action    String
  entity    String?
  entityId  String?
  programId String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([programId])
}

// ───────────── Exam system · Phase 3: question bank (one bank per course) ─────────────
// Public parts of a question (stem, options) live in Question; everything that reveals the answer
// (correct answer, scoring rules, feedback, explanation, option rationale) lives in QuestionSecret,
// which only the exam_* functions read — and later phases never send it during an attempt.

model QuestionCategory {
  id          String             @id @default(dbgenerated("gen_random_uuid()::text"))
  programId   String
  program     Program            @relation(fields: [programId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      QuestionCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    QuestionCategory[] @relation("CategoryTree")
  kind        String // DOMAIN | TOPIC | SUBTOPIC
  nameAr      String
  nameEn      String             @default("")
  sortOrder   Int                @default(0)
  active      Boolean            @default(true)
  createdById String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @default(now()) @updatedAt
  domainOf    Question[]         @relation("QuestionDomain")
  topicOf     Question[]         @relation("QuestionTopic")
  subtopicOf  Question[]         @relation("QuestionSubtopic")

  @@index([programId])
}

model Question {
  id          String            @id @default(dbgenerated("gen_random_uuid()::text"))
  programId   String
  program     Program           @relation(fields: [programId], references: [id], onDelete: Cascade)
  type        String // MCQ | MULTI | TRUE_FALSE | NUMERIC | SHORT | ESSAY | ORDERING | MATCHING (more types in later phases)
  status      String            @default("DRAFT") // DRAFT | ACTIVE | DISABLED
  stemAr      String
  stemEn      String            @default("")
  content     Json              @default("{}") // public parts: options / items / matching lists (never the answer)
  points      Decimal           @default(1) @db.Decimal(8, 2)
  weight      Decimal           @default(1) @db.Decimal(8, 2)
  difficulty  String            @default("MEDIUM") // EASY | MEDIUM | HARD
  domainId    String?
  domain      QuestionCategory? @relation("QuestionDomain", fields: [domainId], references: [id], onDelete: SetNull)
  topicId     String?
  topic       QuestionCategory? @relation("QuestionTopic", fields: [topicId], references: [id], onDelete: SetNull)
  subtopicId  String?
  subtopic    QuestionCategory? @relation("QuestionSubtopic", fields: [subtopicId], references: [id], onDelete: SetNull)
  keywords    String[]          @default([])
  reference   String            @default("")
  version     Int               @default(1)
  createdById String?
  updatedById String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @default(now()) @updatedAt
  secret      QuestionSecret?
  versions    QuestionVersion[]

  @@index([programId, status])
}

model QuestionSecret {
  questionId      String   @id
  question        Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer          Json     @default("{}") // correct answer(s), per type
  scoring         Json     @default("{}") // e.g. {"mode":"ALL_OR_NOTHING"|"PARTIAL"|"PARTIAL_PENALTY"}
  feedbackAr      String   @default("")
  feedbackEn      String   @default("")
  explanationAr   String   @default("")
  explanationEn   String   @default("")
  optionRationale Json     @default("{}") // { optionId: { ar, en } }
  updatedAt       DateTime @default(now()) @updatedAt
}

model QuestionVersion {
  id          String   @id @default(dbgenerated("gen_random_uuid()::text"))
  questionId  String
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  version     Int
  snapshot    Json // full question + secret as it was at this version (attempts will point here)
  createdById String?
  createdAt   DateTime @default(now())

  @@unique([questionId, version])
}
