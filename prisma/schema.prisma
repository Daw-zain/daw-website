// Al Daleel Raqamee – Training & Consulting – data model
// Database: PostgreSQL on Supabase (local dev and the live site share it — see docs/exam-system).
// Enum-like fields are stored as strings (see src/lib/constants.ts).
// Exam-system tables use database-side defaults (dbgenerated / now()) because rows are also
// created by PostgreSQL functions and triggers (supabase/exams.sql), not only by Prisma.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────── Users & security ─────────────

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         String     @default("LEARNER") // ADMIN | EDITOR | LEARNER
  active       Boolean    @default(true)
  locale       String     @default("ar")
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  favorites    Favorite[]
  auditLogs    AuditLog[]
  // LMS-ready: registrations can be linked to a learner account
  registrations Registration[]
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String // create | update | delete | login | export | backup | status
  entity    String
  entityId  String?
  details   String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ───────────── Training ─────────────

model Program {
  id              String    @id @default(cuid())
  slug            String    @unique
  code            String? // short label e.g. PMP
  category        String    @default("certification") // certification | management | agile | technology | tools
  titleAr         String
  titleEn         String
  summaryAr       String
  summaryEn       String
  descriptionAr   String
  descriptionEn   String
  objectivesAr    String    @default("") // one item per line
  objectivesEn    String    @default("")
  audienceAr      String    @default("")
  audienceEn      String    @default("")
  prerequisitesAr String    @default("")
  prerequisitesEn String    @default("")
  outlineAr       String    @default("")
  outlineEn       String    @default("")
  outcomesAr      String    @default("")
  outcomesEn      String    @default("")
  deliveryAr      String    @default("")
  deliveryEn      String    @default("")
  durationAr      String    @default("") // free text, e.g. "5 أيام"
  durationEn      String    @default("")
  hours           Int?
  image           String?
  status          String    @default("COMING_SOON") // OPEN | COMING_SOON | ON_REQUEST | CLOSED
  featured        Boolean   @default(false)
  published       Boolean   @default(true)
  order           Int       @default(0)
  metaTitleAr     String?
  metaTitleEn     String?
  metaDescAr      String?
  metaDescEn      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  sessions        CourseSession[]
  registrations   Registration[]
  // Exam system (docs/exam-system): folders are created automatically by a database trigger
  examFolders     ExamFolder[]
  instructors     CourseInstructor[]
  enrollments     Enrollment[]
  questionCategories QuestionCategory[]
  questions       Question[]
  scenarios       Scenario[]
  examAssets      ExamAsset[]
  exams           Exam[]
}

model CourseSession {
  id            String         @id @default(cuid())
  programId     String
  program       Program        @relation(fields: [programId], references: [id], onDelete: Cascade)
  startDate     DateTime
  endDate       DateTime?
  scheduleAr    String         @default("") // e.g. "الأحد – الخميس، 5:00 – 9:00 م"
  scheduleEn    String         @default("")
  mode          String         @default("IN_PERSON") // IN_PERSON | ONLINE | HYBRID
  locationAr    String         @default("")
  locationEn    String         @default("")
  seats         Int? // null = not announced
  status        String         @default("OPEN") // OPEN | FULL | CLOSED
  published     Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  registrations Registration[]

  @@index([startDate])
}

model Registration {
  id           String         @id @default(cuid())
  programId    String
  program      Program        @relation(fields: [programId], references: [id], onDelete: Cascade)
  sessionId    String?
  session      CourseSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId       String?
  user         User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName     String
  email        String
  phone        String
  organization String?
  jobTitle     String?
  city         String?
  notes        String?
  locale       String         @default("ar")
  status       String         @default("NEW") // NEW | CONTACTED | CONFIRMED | WAITLIST | CANCELLED
  adminNotes   String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([createdAt])
}

// ───────────── Consulting & corporate ─────────────

model ConsultingService {
  id             String                @id @default(cuid())
  slug           String                @unique
  icon           String                @default("pmo")
  titleAr        String
  titleEn        String
  summaryAr      String
  summaryEn      String
  descriptionAr  String
  descriptionEn  String
  deliverablesAr String                @default("")
  deliverablesEn String                @default("")
  published      Boolean               @default(true)
  order          Int                   @default(0)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  requests       ConsultationRequest[]
}

model ConsultationRequest {
  id            String             @id @default(cuid())
  serviceId     String?
  service       ConsultingService? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  name          String
  email         String
  phone         String?
  organization  String?
  description   String
  contactMethod String             @default("EMAIL") // EMAIL | PHONE | WHATSAPP | ONLINE_MEETING
  preferredDate String?
  locale        String             @default("ar")
  status        String             @default("NEW") // NEW | CONTACTED | SCHEDULED | DONE | CLOSED
  adminNotes    String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model CorporateRequest {
  id             String   @id @default(cuid())
  organization   String
  sector         String
  traineesCount  Int?
  programs       String
  mode           String   @default("IN_PERSON")
  duration       String?
  contactName    String
  jobTitle       String?
  email          String
  phone          String
  notes          String?
  attachmentPath String?
  attachmentName String?
  locale         String   @default("ar")
  status         String   @default("NEW") // NEW | CONTACTED | PROPOSAL_SENT | WON | LOST
  adminNotes     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ContactMessage {
  id         String   @id @default(cuid())
  name       String
  email      String
  phone      String?
  subject    String
  message    String
  locale     String   @default("ar")
  status     String   @default("NEW") // NEW | REPLIED | CLOSED
  adminNotes String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ───────────── Knowledge Hub ─────────────

model Resource {
  id          String     @id @default(cuid())
  slug        String     @unique
  type        String     @default("ARTICLE") // ARTICLE | TIP | VIDEO | TEMPLATE | QUIZ
  category    String     @default("general") // pmp | pmbok | risk | agile | ai | general
  titleAr     String
  titleEn     String
  excerptAr   String     @default("")
  excerptEn   String     @default("")
  bodyAr      String     @default("") // Markdown
  bodyEn      String     @default("")
  coverImage  String?
  videoUrl    String? // YouTube / Vimeo URL
  fileUrl     String? // downloadable template
  quizJson    String? // see docs/ADMIN-GUIDE.md for the format
  readMinutes Int?
  published   Boolean    @default(true)
  featured    Boolean    @default(false)
  publishedAt DateTime   @default(now())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  favorites   Favorite[]

  @@index([publishedAt])
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, resourceId])
}

// ───────────── Credibility content ─────────────

model Credential {
  id           String   @id @default(cuid())
  kind         String   @default("PROFESSIONAL") // PROFESSIONAL | ACADEMIC
  code         String? // PMP, RMP, ACP …
  titleAr      String
  titleEn      String
  issuerAr     String
  issuerEn     String
  year         Int?
  credentialId String?
  verifyUrl    String?
  image        String?
  descriptionAr String  @default("")
  descriptionEn String  @default("")
  published    Boolean  @default(true)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Testimonial {
  id         String   @id @default(cuid())
  name       String
  roleAr     String   @default("")
  roleEn     String   @default("")
  quoteAr    String
  quoteEn    String
  programRef String?
  photo      String?
  consent    Boolean  @default(false) // the person approved publishing
  published  Boolean  @default(false)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Stat {
  id        String   @id @default(cuid())
  value     Int
  prefix    String   @default("")
  suffix    String   @default("")
  labelAr   String
  labelEn   String
  source    String   @default("") // internal note: where this number comes from
  animate   Boolean  @default(true)
  published Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Faq {
  id         String   @id @default(cuid())
  scope      String   @default("general") // general | corporate | consulting | programs
  questionAr String
  questionEn String
  answerAr   String
  answerEn   String
  published  Boolean  @default(true)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ───────────── Newsletter, media, settings, notifications ─────────────

model Subscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  locale         String    @default("ar")
  token          String    @unique
  confirmedAt    DateTime?
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
}

model Media {
  id        String   @id @default(cuid())
  filename  String
  path      String // storage-relative path
  url       String // public URL (/uploads/…)
  mime      String
  size      Int
  altAr     String   @default("")
  altEn     String   @default("")
  createdAt DateTime @default(now())
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Notification {
  id        String    @id @default(cuid())
  type      String // registration | consultation | corporate | contact | subscriber
  title     String
  body      String
  link      String?
  read      Boolean   @default(false)
  emailedAt DateTime?
  emailError String?
  createdAt DateTime  @default(now())

  @@index([createdAt])
}

// ───────────── Exam system · Phase 1: members, course roles, enrollment, folders ─────────────
// Online identity = Supabase Auth (auth.users). ExamMember maps an auth user to a role.
// Browser roles (anon / authenticated) have NO direct access to these tables: everything goes
// through SECURITY DEFINER functions in supabase/exams.sql that check the caller's session.

model ExamMember {
  id          String             @id @default(dbgenerated("gen_random_uuid()::text"))
  authUserId  String             @unique // auth.users.id
  email       String             @unique
  name        String             @default("")
  role        String             @default("LEARNER") // ADMIN (= super admin) | STAFF (admin with a role) | INSTRUCTOR | LEARNER
  active      Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @default(now()) @updatedAt
  instructing CourseInstructor[]
  enrollments Enrollment[]
  // LMS-1: what a STAFF member may do (ignored for every other role)
  adminRoleId String?
  adminRole   AdminRole?         @relation(fields: [adminRoleId], references: [id], onDelete: Restrict)
}

// ───────────── LMS-1: administrative roles ─────────────
// A named set of permissions the super admin gives to STAFF members. "permissions" is
// { "<section>": ["<action>", …] } — the allowed values are defined in supabase/lms-access.sql,
// where every permission is enforced.
model AdminRole {
  id          String       @id @default(dbgenerated("gen_random_uuid()::text"))
  key         String       @unique
  nameAr      String
  nameEn      String       @default("")
  descAr      String       @default("")
  descEn      String       @default("")
  system      Boolean      @default(false) // shipped with the platform: editable, not deletable
  active      Boolean      @default(true)
  permissions Json         @default("{}")
  createdById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now()) @updatedAt
  members     ExamMember[]
}

model CourseInstructor {
  id                    String     @id @default(dbgenerated("gen_random_uuid()::text"))
  programId             String
  program               Program    @relation(fields: [programId], references: [id], onDelete: Cascade)
  memberId              String
  member                ExamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  // Flexible permissions set by the admin (section 17.5)
  canEditQuestions      Boolean    @default(true)
  canDeleteQuestions    Boolean    @default(false)
  canManageCategories   Boolean    @default(true)
  canManageScenarios    Boolean    @default(true)
  canImport             Boolean    @default(true)
  canExport             Boolean    @default(false)
  canCreateExams        Boolean    @default(true)
  canPublishExams       Boolean    @default(false) // false = needs admin approval
  canManageDomainTests  Boolean    @default(true)
  canManageSimulations  Boolean    @default(true)
  canViewResults        Boolean    @default(true)
  canReviewEssays       Boolean    @default(true)
  canReopenAttempts     Boolean    @default(false)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @default(now()) @updatedAt

  @@unique([programId, memberId])
}

model Enrollment {
  id             String     @id @default(dbgenerated("gen_random_uuid()::text"))
  programId      String
  program        Program    @relation(fields: [programId], references: [id], onDelete: Cascade)
  memberId       String
  member         ExamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  status         String     @default("ACTIVE") // ACTIVE | SUSPENDED | COMPLETED
  registrationId String?    // the Registration request it came from, if any
  createdById    String?    // ExamMember.id of the admin/instructor who enrolled
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @default(now()) @updatedAt

  @@unique([programId, memberId])
}

model ExamFolder {
  id          String   @id @default(dbgenerated("gen_random_uuid()::text"))
  programId   String
  program     Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  kind        String // QUESTION_BANK | DOMAIN_TESTS | EXAM_SIMULATIONS | MISTAKES_QUIZ | RESULTS | CUSTOM
  system      Boolean  @default(false) // the 5 built-in folders; one per kind per course (unique index in SQL)
  nameAr      String
  nameEn      String
  descAr      String   @default("")
  descEn      String   @default("")
  status      String   @default("ACTIVE") // ACTIVE | HIDDEN | ARCHIVED
  sortOrder   Int      @default(0)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  exams       Exam[]

  @@index([programId])
}

model ExamAuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()::text"))
  actorId   String? // ExamMember.id
  action    String
  entity    String?
  entityId  String?
  programId String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([programId])
}

// ───────────── Exam system · Phase 3: question bank (one bank per course) ─────────────
// Public parts of a question (stem, options) live in Question; everything that reveals the answer
// (correct answer, scoring rules, feedback, explanation, option rationale) lives in QuestionSecret,
// which only the exam_* functions read — and later phases never send it during an attempt.

model QuestionCategory {
  id          String             @id @default(dbgenerated("gen_random_uuid()::text"))
  programId   String
  program     Program            @relation(fields: [programId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      QuestionCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    QuestionCategory[] @relation("CategoryTree")
  kind        String // DOMAIN | TOPIC | SUBTOPIC
  nameAr      String
  nameEn      String             @default("")
  sortOrder   Int                @default(0)
  active      Boolean            @default(true)
  createdById String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @default(now()) @updatedAt
  domainOf    Question[]         @relation("QuestionDomain")
  topicOf     Question[]         @relation("QuestionTopic")
  subtopicOf  Question[]         @relation("QuestionSubtopic")

  @@index([programId])
}

model Question {
  id          String            @id @default(dbgenerated("gen_random_uuid()::text"))
  programId   String
  program     Program           @relation(fields: [programId], references: [id], onDelete: Cascade)
  type        String // MCQ | MULTI | TRUE_FALSE | NUMERIC | SHORT | ESSAY | ORDERING | MATCHING (more types in later phases)
  status      String            @default("DRAFT") // DRAFT | ACTIVE | DISABLED
  stemAr      String
  stemEn      String            @default("")
  content     Json              @default("{}") // public parts: options / items / matching lists (never the answer)
  points      Decimal           @default(1) @db.Decimal(8, 2)
  weight      Decimal           @default(1) @db.Decimal(8, 2)
  difficulty  String            @default("MEDIUM") // EASY | MEDIUM | HARD
  domainId    String?
  domain      QuestionCategory? @relation("QuestionDomain", fields: [domainId], references: [id], onDelete: SetNull)
  topicId     String?
  topic       QuestionCategory? @relation("QuestionTopic", fields: [topicId], references: [id], onDelete: SetNull)
  subtopicId  String?
  subtopic    QuestionCategory? @relation("QuestionSubtopic", fields: [subtopicId], references: [id], onDelete: SetNull)
  keywords    String[]          @default([])
  reference   String            @default("")
  version     Int               @default(1)
  createdById String?
  updatedById String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @default(now()) @updatedAt
  secret      QuestionSecret?
  versions    QuestionVersion[]
  examItems   ExamItem[]
  attemptQuestions AttemptQuestion[]
  // Phase 4: a question may belong to one multi-question scenario (shared case text, shown once)
  scenarioId    String?
  scenario      Scenario?       @relation(fields: [scenarioId], references: [id], onDelete: Restrict)
  scenarioOrder Int             @default(0)

  @@index([programId, status])
  @@index([scenarioId])
}

model QuestionSecret {
  questionId      String   @id
  question        Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer          Json     @default("{}") // correct answer(s), per type
  scoring         Json     @default("{}") // e.g. {"mode":"ALL_OR_NOTHING"|"PARTIAL"|"PARTIAL_PENALTY"}
  feedbackAr      String   @default("")
  feedbackEn      String   @default("")
  explanationAr   String   @default("")
  explanationEn   String   @default("")
  optionRationale Json     @default("{}") // { optionId: { ar, en } }
  updatedAt       DateTime @default(now()) @updatedAt
}

model QuestionVersion {
  id          String   @id @default(dbgenerated("gen_random_uuid()::text"))
  questionId  String
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  version     Int
  snapshot    Json // full question + secret as it was at this version (attempts will point here)
  createdById String?
  createdAt   DateTime @default(now())

  @@unique([questionId, version])
}

// ───────────── Exam system · Phase 4: multi-question scenarios + private attachments ─────────────

model Scenario {
  id           String            @id @default(dbgenerated("gen_random_uuid()::text"))
  programId    String
  program      Program           @relation(fields: [programId], references: [id], onDelete: Cascade)
  titleAr      String
  titleEn      String            @default("")
  bodyAr       String            @default("")
  bodyEn       String            @default("")
  // structured case data, each part {ar, en}: project, events, constraints, risks, stakeholders, info
  details      Json              @default("{}")
  // tables: [{ captionAr, captionEn, rows: string[][] }] (first row = header)
  tables       Json              @default("[]")
  displayMode  String            @default("SIDE") // SIDE (beside each question) | SECTION (own section)
  status       String            @default("DRAFT") // DRAFT | ACTIVE | DISABLED
  version      Int               @default(1)
  createdById  String?
  updatedById  String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @default(now()) @updatedAt
  questions    Question[]
  versions     ScenarioVersion[]

  @@index([programId])
}

model ScenarioVersion {
  id          String   @id @default(dbgenerated("gen_random_uuid()::text"))
  scenarioId  String
  scenario    Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  version     Int
  snapshot    Json
  createdById String?
  createdAt   DateTime @default(now())

  @@unique([scenarioId, version])
}

// Images and files of questions / scenarios. The file itself lives in the PRIVATE Supabase Storage
// bucket "exam-assets" at <programId>/<ownerId>/<uuid>.<ext>; it is only reachable through short-lived
// signed URLs, which storage policies allow only to staff of that course (and, in later phases, to a
// learner during an attempt that contains the question).
model ExamAsset {
  id          String   @id @default(dbgenerated("gen_random_uuid()::text"))
  programId   String
  program     Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  ownerType   String // QUESTION | SCENARIO
  ownerId     String
  kind        String // IMAGE | FILE
  path        String   @unique
  mime        String
  size        Int
  fileName    String   @default("")
  captionAr   String   @default("")
  captionEn   String   @default("")
  sortOrder   Int      @default(0)
  createdById String?
  createdAt   DateTime @default(now())

  @@index([ownerType, ownerId])
}

// ───────────── Exam system · Phase 5: exam builder ─────────────
// An exam lives in one folder of its course (Domain Tests / Exam Simulations / custom) and is built from
// that course's bank: hand-picked questions (ExamItem) and/or random-draw rules (ExamRule). Every setting
// the brief lists (timing, attempts, order, review/result/feedback policies, tools, security) is a column
// or the "security" JSON. Effective score of a question = points × weight.

model Exam {
  id                String     @id @default(dbgenerated("gen_random_uuid()::text"))
  programId         String
  program           Program    @relation(fields: [programId], references: [id], onDelete: Cascade)
  folderId          String
  folder            ExamFolder @relation(fields: [folderId], references: [id], onDelete: Restrict)
  titleAr           String
  titleEn           String     @default("")
  descAr            String     @default("")
  descEn            String     @default("")
  examType          String     @default("PRACTICE") // PRACTICE | SIMULATION | FINAL
  durationMinutes   Int? // null = untimed
  graceSeconds      Int        @default(0)
  startsAt          DateTime?
  endsAt            DateTime?
  maxAttempts       Int? // null = unlimited
  shuffleQuestions  Boolean    @default(true)
  shuffleOptions    Boolean    @default(true)
  passPercent       Decimal    @default(70) @db.Decimal(5, 2)
  reviewPolicy      String     @default("AFTER_SUBMIT") // NEVER | AFTER_SUBMIT | AFTER_CLOSE
  resultsPolicy     String     @default("IMMEDIATE") // IMMEDIATE | AFTER_CLOSE | MANUAL
  showFeedback      Boolean    @default(true) // in review only, never during the attempt
  showExplanation   Boolean    @default(true) // in review only
  showCorrect       Boolean    @default(true) // correct answers in review
  allowCalculator   Boolean    @default(false)
  allowWhiteboard   Boolean    @default(false)
  allowTranslation  Boolean    @default(true)
  resumePolicy      String     @default("RESUME") // RESUME (timer keeps running) | NO_RESUME
  security          Json       @default("{}") // {fullscreen, detectBlur, maxWarnings, onExceed: WARN|SUBMIT|REVIEW, watermark, blockCopy}
  status            String     @default("DRAFT") // DRAFT | PENDING_APPROVAL | PUBLISHED | STOPPED | ARCHIVED
  reviewNote        String     @default("") // admin note when sending back to draft
  approvedById      String?
  approvedAt        DateTime?
  publishedAt       DateTime?
  version           Int        @default(1)
  createdById       String?
  updatedById       String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @default(now()) @updatedAt
  items             ExamItem[]
  rules             ExamRule[]
  resultsReleasedAt DateTime? // for resultsPolicy MANUAL
  attempts          ExamAttempt[]
  extraAttempts     ExamExtraAttempt[]

  @@index([programId, status])
  @@index([folderId])
}

model ExamItem {
  id         String   @id @default(dbgenerated("gen_random_uuid()::text"))
  examId     String
  exam       Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Restrict)
  position   Int
  points     Decimal? @db.Decimal(8, 2) // null = the question's own points
  weight     Decimal? @db.Decimal(8, 2) // null = the question's own weight

  @@unique([examId, questionId])
  @@index([examId, position])
}

model ExamRule {
  id         String   @id @default(dbgenerated("gen_random_uuid()::text"))
  examId     String
  exam       Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  position   Int
  count      Int // how many questions to draw (for a scenario rule: how many scenarios)
  domainId   String?
  topicId    String?
  subtopicId String?
  difficulty String? // EASY | MEDIUM | HARD
  qtype      String? // question type
  scenarios  Boolean  @default(false) // false = standalone questions; true = draw whole scenarios (all their active questions)
  points     Decimal? @db.Decimal(8, 2)
  weight     Decimal? @db.Decimal(8, 2)

  @@index([examId, position])
}

// ───────────── Exam system · Phase 6: attempts, server timer, grading ─────────────
// When a learner starts, the questions are drawn ONCE and frozen in AttemptQuestion together with the
// question version used. "publicData" is what the browser receives (shuffled, no answer); "snapshot"
// holds the full question + answer and is only read by the grading / review functions.

model ExamAttempt {
  id            String            @id @default(dbgenerated("gen_random_uuid()::text"))
  examId        String
  exam          Exam              @relation(fields: [examId], references: [id], onDelete: Restrict)
  programId     String
  memberId      String
  attemptNo     Int
  status        String            @default("IN_PROGRESS") // IN_PROGRESS | SUBMITTED (awaiting essay grading) | COMPLETED | TIMED_OUT | ABANDONED | UNDER_REVIEW | CANCELLED
  startedAt     DateTime          @default(now())
  deadlineAt    DateTime? // server-side end of the attempt (null = untimed)
  graceSeconds  Int               @default(0)
  lastSeenAt    DateTime          @default(now())
  submittedAt   DateTime?
  gradedAt      DateTime?
  score         Decimal?          @db.Decimal(10, 2)
  maxScore      Decimal?          @db.Decimal(10, 2)
  percent       Decimal?          @db.Decimal(5, 2)
  passed        Boolean?
  questionCount Int               @default(0)
  answeredCount Int               @default(0)
  flaggedCount  Int               @default(0)
  correctCount  Int               @default(0)
  wrongCount    Int               @default(0)
  needsManual   Boolean           @default(false)
  warnings      Int               @default(0)
  settings      Json              @default("{}") // exam settings frozen at start (policies, tools, security, pass mark)
  staffNote     String            @default("")
  reviewFlag    Boolean           @default(false) // phase 8: warnings exceeded with action REVIEW → result held until staff clear it
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @default(now()) @updatedAt
  questions     AttemptQuestion[]

  @@index([examId, memberId])
  @@index([memberId, status])
}

model AttemptQuestion {
  id              String      @id @default(dbgenerated("gen_random_uuid()::text"))
  attemptId       String
  attempt         ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  position        Int
  questionId      String
  question        Question    @relation(fields: [questionId], references: [id], onDelete: Restrict)
  questionVersion Int
  scenarioId      String?
  type            String
  points          Decimal     @db.Decimal(8, 2) // effective points × weight for this attempt
  publicData      Json // what the learner sees: stem, shuffled options/items, unit, word limits, image paths
  snapshot        Json // full question incl. answer, feedback, explanation (server only)
  response        Json? // the learner's answer
  flagged         Boolean     @default(false)
  savedAt         DateTime?
  score           Decimal?    @db.Decimal(8, 2)
  isCorrect       Boolean?
  manualScore     Decimal?    @db.Decimal(8, 2)
  graderComment   String      @default("")
  gradedById      String?
  gradedAt        DateTime?

  @@unique([attemptId, position])
  @@index([attemptId])
  @@index([questionId])
}

// extra attempts granted by staff beyond Exam.maxAttempts
model ExamExtraAttempt {
  id          String   @id @default(dbgenerated("gen_random_uuid()::text"))
  examId      String
  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  memberId    String
  extra       Int      @default(1)
  createdById String?
  createdAt   DateTime @default(now())

  @@unique([examId, memberId])
}

// ───────────── Exam system · Phase 8: proctoring + rate limiting ─────────────

// Browser-behaviour events reported during an attempt (leaving the page, losing focus, leaving full
// screen, copy / paste / right-click attempts). Recorded and counted on the server.
model ProctorEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()::text"))
  attemptId String
  memberId  String
  programId String
  kind      String // HIDDEN | BLUR | FULLSCREEN_EXIT | COPY | PASTE | CONTEXT_MENU | PRINT | SHORTCUT
  counted   Boolean  @default(false) // counted as a warning
  detail    String   @default("")
  createdAt DateTime @default(now())

  @@index([attemptId, createdAt])
}

// Sliding one-minute counters per member and function (abnormal request rates are refused and logged)
model ExamRateLimit {
  key         String   @id // "<scope>:<memberId>"
  windowStart DateTime @default(now())
  count       Int      @default(0)
  flaggedAt   DateTime?
}

// ───────────── Exam system · Phase 9: Mistakes Quiz ─────────────
// Every question a learner answers wrongly in an exam is collected once per learner (MistakeItem) with a
// frozen copy of the question version, how often it was wrong and the dates (MistakeHistory). Review
// sessions (MistakeSession) are personal and never touch official attempts or grades.

model MistakeItem {
  id              String    @id @default(dbgenerated("gen_random_uuid()::text"))
  memberId        String
  programId       String
  questionId      String
  questionVersion Int
  snapshot        Json // the question as it was when last answered wrongly (incl. answer — server only)
  type            String
  domainId        String?
  topicId         String?
  subtopicId      String?
  difficulty      String?
  status          String    @default("WRONG_NOT_REVIEWED") // WRONG_NOT_REVIEWED | REVIEWED | CORRECT_IN_REVIEW | WRONG_AGAIN | MASTERED
  wrongCount      Int       @default(1) // wrong answers in official exams
  reviewCorrect   Int       @default(0)
  reviewWrong     Int       @default(0)
  correctStreak   Int       @default(0) // consecutive correct review sessions
  firstWrongAt    DateTime  @default(now())
  lastWrongAt     DateTime  @default(now())
  lastReviewedAt  DateTime?
  masteredAt      DateTime?
  lastAttemptId   String?
  lastExamId      String?
  lastResponse    Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
  history         MistakeHistory[]

  @@unique([memberId, questionId])
  @@index([memberId, programId, status])
  @@index([programId, questionId])
}

model MistakeHistory {
  id        String      @id @default(dbgenerated("gen_random_uuid()::text"))
  mistakeId String
  mistake   MistakeItem @relation(fields: [mistakeId], references: [id], onDelete: Cascade)
  kind      String // WRONG_IN_EXAM | REVIEW_CORRECT | REVIEW_WRONG | VIEWED | MASTERED | REOPENED
  attemptId String?
  sessionId String?
  response  Json?
  createdAt DateTime    @default(now())

  @@index([mistakeId, createdAt])
}

model MistakeSession {
  id            String                   @id @default(dbgenerated("gen_random_uuid()::text"))
  memberId      String
  programId     String
  status        String                   @default("IN_PROGRESS") // IN_PROGRESS | COMPLETED
  feedbackMode  String                   @default("AFTER_ANSWER") // AFTER_ANSWER | AFTER_SESSION
  deadlineAt    DateTime? // optional timer
  questionCount Int                      @default(0)
  correctCount  Int                      @default(0)
  score         Decimal?                 @db.Decimal(8, 2)
  maxScore      Decimal?                 @db.Decimal(8, 2)
  createdAt     DateTime                 @default(now())
  submittedAt   DateTime?
  questions     MistakeSessionQuestion[]

  @@index([memberId, programId, status])
}

model MistakeSessionQuestion {
  id         String         @id @default(dbgenerated("gen_random_uuid()::text"))
  sessionId  String
  session    MistakeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  position   Int
  mistakeId  String
  publicData Json
  response   Json?
  isCorrect  Boolean?
  answeredAt DateTime?

  @@unique([sessionId, position])
}
