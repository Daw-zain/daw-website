{
  "name": "daw-zainelabideen-website",
  "version": "1.0.0",
  "private": true,
  "description": "Daw Zainelabideen – Project Management Training & Consulting (bilingual AR/EN website + admin dashboard)",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "db:setup": "prisma db push && tsx --env-file-if-exists=.env prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:use-postgres": "node scripts/use-postgres.mjs",
    "backup": "tsx --env-file-if-exists=.env scripts/backup.ts",
    "restore": "tsx --env-file-if-exists=.env scripts/restore.ts",
    "mail:test": "tsx --env-file-if-exists=.env scripts/mail-test.ts",
    "admin:reset-password": "tsx --env-file-if-exists=.env scripts/reset-password.ts"
  },
  "prisma": {
    "seed": "tsx --env-file-if-exists=.env prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "framer-motion": "^12.43.0",
    "jose": "^6.2.18",
    "marked": "^15.0.12",
    "next": "^15.5.29",
    "nodemailer": "^7.0.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanitize-html": "^2.18.2",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "postcss": "^8.5.33",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true
  }
}
